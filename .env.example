# AccessAble Backend Configuration Example
# Copy this file to backend/.env and adjust variables as needed for your environment.

# Application metadata
APP_NAME="AccessAble API"
API_PREFIX="/api/v1"

# SQLite database connection URL
DATABASE_URL="sqlite:///./accessable.db"

# Allowed CORS origins for frontend integration (comma-separated list)
# Default is Vite dev server: http://localhost:5173
# For Next.js/Create-React-App: http://localhost:3000
# Example with multiple origins: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ORIGINS="http://localhost:5173"

# Whether credentials (cookies / authorization headers) are allowed across CORS origins
# AccessAble API endpoints are currently stateless and tokenless, defaulting to false.
CORS_ALLOW_CREDENTIALS=false

# Ring Partner API configuration. Keep actual values in backend/.env or the
# deployment secret store. Do not commit credential-bearing files.
RING_CLIENT_ID=""
RING_CLIENT_SECRET=""
RING_HMAC_SIGNING_KEY=""
RING_API_BASE_URL="https://api.amazonvision.com"
RING_ENVIRONMENT="staging"
